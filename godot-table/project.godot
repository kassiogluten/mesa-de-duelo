; Configuração do projeto Godot da mesa nova (ver docs/spec-mesa-godot.md).

config_version=5

[application]

config/name="Mesa de Duelo"
config/version="0.0.0"
run/main_scene="res://boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://boot/icon.png"
config/windows_native_icon="res://boot/icon.ico"
boot_splash/bg_color=Color(0.06, 0.07, 0.1, 1)
boot_splash/image="res://boot/splash.png"
boot_splash/stretch_mode=0
boot_splash/use_filter=true

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/screen_space_aa=2
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
