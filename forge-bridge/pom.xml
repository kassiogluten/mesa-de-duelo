<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>mesadeduelo</groupId>
  <artifactId>forge-bridge</artifactId>
  <version>0.1.0</version>
  <name>Mesa de Duelo - ponte para o Forge</name>
  <licenses>
    <license><name>GPL-3.0-or-later</name></license>
  </licenses>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Versão instalada no repositório Maven local por "mvn -pl forge-gui -am install" no clone do Forge. -->
    <forge.version>2.0.16-SNAPSHOT</forge.version>
    <!-- Onde está o clone do Forge (o "npm run forge:instalar" põe em ~/forge). Outro lugar: -Dforge.dir=/caminho. -->
    <forge.dir>${user.home}/forge</forge.dir>
    <!-- Vazio para o @{argLine} do surefire; um -DargLine na linha de comando continua somando. -->
    <argLine></argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>forge</groupId>
      <artifactId>forge-gui</artifactId>
      <version>${forge.version}</version>
    </dependency>
    <!-- Métricas no formato do Prometheus em /metrics (uso, partidas e JVM). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <version>1.13.6</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>../shared</directory><includes><include>starter-decks.json</include><include>pauper-legality.json</include><include>commander-legality.json</include><include>oathbreaker-legality.json</include></includes></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.1.2</version>
        <configuration>
          <argLine>@{argLine} -Dforge.dir=${forge.dir}</argLine>
          <systemPropertyVariables><forge.dir>${forge.dir}</forge.dir></systemPropertyVariables>
          <!-- Liga o motor do Forge antes de qualquer classe de teste (EngineListener). -->
          <properties><property><name>listener</name><value>mesadeduelo.bridge.EngineListener</value></property></properties>
          <!-- Para combinar classes com -Dtest=A,B sem falhar quando um padrão não acha nada. -->
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>mesadeduelo.bridge.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
