{
  "name": "mesa-de-duelo",
  "private": true,
  "version": "0.251.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rede": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:protocol": "node forge-bridge/scripts/test-protocol.mjs",
    "forge": "bash forge-bridge/scripts/rodar.sh",
    "forge:rede": "bash forge-bridge/scripts/rodar.sh --host=0.0.0.0",
    "forge:instalar": "bash forge-bridge/scripts/instalar-forge.sh",
    "icons": "pwa-assets-generator",
    "print": "node scripts/print-novidade.mjs",
    "sons": "node scripts/sons-mp3.mjs",
    "sons:elevenlabs": "node scripts/sons-elevenlabs.mjs",
    "publicar-versao": "node --import ./tests/register.mjs scripts/publicar-versao.mjs",
    "arte": "node scripts/arte-propria.mjs",
    "prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\"",
    "test:browser": "node scripts/test-browser.mjs",
    "unused": "node scripts/unused-exports.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "visual": "node scripts/visual-diff.mjs",
    "css-why": "node scripts/css-why.mjs",
    "mapa": "node scripts/mapa.mjs",
    "relatos": "node --import ./tests/register.mjs deploy/relatos.mjs",
    "protocol-doc": "node scripts/protocol-doc.mjs",
    "protocol-godot": "node scripts/protocol-godot.mjs",
    "godot": "node scripts/godot.mjs",
    "godot:smoke": "node scripts/godot.mjs --headless --script res://tools/smoke.gd",
    "godot:partida": "node scripts/godot.mjs --headless --script res://tools/match_check.gd",
    "godot:crossplay": "node --import ./tests/register.mjs scripts/godot-crossplay.mjs",
    "godot:test": "node scripts/godot.mjs --headless --script res://tools/run_tests.gd --",
    "godot:golden": "node --import ./tests/register.mjs scripts/godot-golden.mjs",
    "godot:pck": "node scripts/godot-pck.mjs",
    "godot:zip": "node scripts/godot-zip.mjs",
    "godot:test-atualizador": "node scripts/godot-updater-test.mjs"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^0.2.6",
    "agent-browser": "0.27.0",
    "pixi.js": "8.22.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
