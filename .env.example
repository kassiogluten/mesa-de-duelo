# Copie para .env (fica fora do git). Lido pelo `npm run forge`.
# Senha da área de admin (/admin.html) na ponte local.
MESA_ADMIN_PASSWORD=admin
# Client ID do Google (OAuth "Web application", com http://localhost:5173 nas origens): liga o Entrar com Google.
# A ponte lê MESA_GOOGLE_CLIENT_ID; o site (Vite) lê VITE_GOOGLE_CLIENT_ID. Os dois têm o mesmo valor.
MESA_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
